# Local-only configuration template. Copy values into your shell or local .env;
# never commit credentials. Generate a private key before running Django.
DJANGO_SECRET_KEY=replace-this-value-with-a-generated-secret-of-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

DATABASE_NAME=blast_ecom
DATABASE_USER=blast_ecom
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Optional host-side port override if another local PostgreSQL already uses 5432.
BLAST_ECOM_POSTGRES_HOST_PORT=5432
BLAST_ECOM_FRONTEND_HOST_PORT=5173

# Explicit opt-in required for creating the fictional catalog fixture.
BLAST_ECOM_ALLOW_LOCAL_SEED=false

# Public customer flows stay disabled unless a reviewed hosted environment explicitly enables them.
BLAST_ECOM_PUBLIC_ACCOUNT_FLOWS_ENABLED=false

# Local deterministic payment simulator is the default in DEBUG. For a real Stripe
# sandbox, select stripe_sandbox and provide test-mode API and webhook signing secrets.
# Outside DEBUG, payments default to disabled and the simulator is prohibited.
BLAST_ECOM_PAYMENT_PROVIDER=simulator
# BLAST_ECOM_PAYMENT_PROVIDER=stripe_sandbox
# BLAST_ECOM_STRIPE_SECRET_KEY=<Stripe sandbox secret key beginning sk_test_>
# BLAST_ECOM_STRIPE_WEBHOOK_SECRET=<webhook signing secret beginning whsec_>

# Production-only examples (uncomment and supply reviewed values outside local development):
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<private random value of at least 50 characters>
# DJANGO_ALLOWED_HOSTS=shop.example.com,api.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# BLAST_ECOM_FRONTEND_URL=https://shop.example.com
# DJANGO_SECURE_HSTS_SECONDS=86400
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=<mounted CA certificate path>
# BLAST_ECOM_TRUSTED_PROXY_CIDRS=<exact ingress proxy CIDR(s), comma-separated>
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=<SMTP host>
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=<SMTP user>
# DJANGO_EMAIL_HOST_PASSWORD=<external secret, never commit>
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false
# DJANGO_DEFAULT_FROM_EMAIL=Blast Ecom <no-reply@example.com>
# BLAST_ECOM_PUBLIC_ACCOUNT_FLOWS_ENABLED=true
